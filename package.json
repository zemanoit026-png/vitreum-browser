{
  "name": "vitreum-browser",
  "version": "1.2.0",
  "description": "Vitreum Ultimate Custom Browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.3.1"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.vitreum.browser",
    "productName": "Vitreum Browser",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ]
  },
  "author": "Vitreum"
}